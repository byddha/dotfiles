# noctty (Ghostty fork for Windows), linked to %LOCALAPPDATA%\noctty\config.ghostty
# Keybinds mirror ../../.config/ghostty/config

# Shell
command = direct:pwsh.exe -NoLogo -NoProfileLoadTime -ExecutionPolicy RemoteSigned
working-directory = home
auto-update = off

# Appearance
font-family = CaskaydiaCove Nerd Font Mono
font-size = 14
window-padding-x = 6
window-padding-y = 3
cursor-style-blink = true
link-url = true
link-previews = osc8
shell-integration-features = ssh-terminfo

# Keybinds
keybind = ctrl+enter=new_window
keybind = alt+n=jump_to_prompt:1
keybind = alt+shift+n=jump_to_prompt:-1
keybind = alt+e=write_scrollback_file:open,plain
keybind = alt+f=start_search

# noctty 1.3.130 bug: goto_tab is 0-indexed (goto_tab:1 opens the 2nd tab)
keybind = alt+1=goto_tab:0
keybind = alt+2=goto_tab:1
keybind = alt+3=goto_tab:2
keybind = alt+4=goto_tab:3
keybind = alt+5=goto_tab:4
keybind = alt+6=goto_tab:5
keybind = alt+7=goto_tab:6
keybind = alt+8=goto_tab:7
keybind = alt+digit_1=goto_tab:0
keybind = alt+digit_2=goto_tab:1
keybind = alt+digit_3=goto_tab:2
keybind = alt+digit_4=goto_tab:3
keybind = alt+digit_5=goto_tab:4
keybind = alt+digit_6=goto_tab:5
keybind = alt+digit_7=goto_tab:6
keybind = alt+digit_8=goto_tab:7

# Window mode (alt+w then key, one-shot like C-w in nvim)
keybind = alt+w=activate_key_table_once:win
keybind = win/
keybind = win/h=goto_split:left
keybind = win/j=goto_split:bottom
keybind = win/k=goto_split:top
keybind = win/l=goto_split:right
keybind = win/s=new_split:down
keybind = win/v=new_split:right
keybind = win/q=close_surface
keybind = win/z=toggle_split_zoom
keybind = win/equal=equalize_splits
keybind = win/escape=deactivate_key_table
keybind = win/catch_all=ignore

# Vim mode (alt+; to enter, escape/q/i to exit)
keybind = alt+semicolon=activate_key_table:vim
keybind = vim/
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next
keybind = vim/shift+n=navigate_search:previous
keybind = vim/p=jump_to_prompt:1
keybind = vim/shift+p=jump_to_prompt:-1
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard
keybind = vim/e=write_scrollback_file:open,plain
keybind = vim/shift+semicolon=toggle_command_palette
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table
keybind = vim/catch_all=ignore
