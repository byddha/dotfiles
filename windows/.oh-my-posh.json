{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ if .Root }}admin @ {{ end }}{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "#d7af00",
          "template": " "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#0087af",
          "properties": {
            "style": "folder",
            "home_icon": "~"
          },
          "template": "{{ .Parent }}<b><#00afff>{{ .Path }}</></b> "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#5fd700",
          "foreground_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}#d7af00{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": "{{ .HEAD }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if .Staging.Changed }} +{{ add .Staging.Added .Staging.Modified .Staging.Deleted }}{{ end }}{{ if or (gt .Working.Modified 0) (gt .Working.Deleted 0) }} !{{ add .Working.Modified .Working.Deleted }}{{ end }}{{ if gt .Working.Untracked 0 }} ?{{ .Working.Untracked }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#5fd700",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff0000{{ end }}"
          ],
          "template": "❯"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#d70000",
          "template": "✘ {{ .Code }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#87875f",
          "properties": {
            "threshold": 3000,
            "style": "austin"
          },
          "template": "{{ .FormattedMs }}  "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#00afaf",
          "properties": {
            "display_mode": "environment",
            "fetch_version": false,
            "fetch_virtual_env": true
          },
          "template": "{{ .Venv }}  "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#5f8787",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "{{ .CurrentDate | date .Format }} "
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "#5fd700",
    "template": "❯❯ "
  }
}
