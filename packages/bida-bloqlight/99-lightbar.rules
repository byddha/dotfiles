# ROBOBLOQ USB Light Bar udev rules
#
# Install:
#   sudo cp 99-lightbar.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   # Then unplug and replug the device
#
# Verify:
#   - LED control works without sudo
#   - No "Keyboard" line in: journalctl -k | grep -i "1a86" | tail -5

# Allow non-root access to the device
# - hidraw: for direct HID access
# - usb: for libusb access (used by karalabe/hid library)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe07", MODE="0666", TAG+="systemd", ENV{SYSTEMD_WANTS}="bloqlight.service"
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="fe07", MODE="0666"

# Block the keyboard interface (BadUSB prevention)
# The device injects Win+R and a URL on connect - this disables that
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe07", ATTR{bInterfaceNumber}=="01", ATTR{authorized}="0"
