# The greeter's home: its state and caches, its own only, so nothing it loads can be planted there
d /var/lib/bidshell-greeter 0700 greeter greeter -
# The user's theme and wallpapers for the greeter: greeter/sync writes them (the user is in the
# greeter group), the greeter only reads them
d /var/cache/bidshell-greeter 2770 greeter greeter -
