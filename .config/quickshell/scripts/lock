#!/bin/bash
# Locks the session with lock.qml, and starts it again if it crashes: the session stays locked
# (Hyprland's misc:allow_session_lock_restore lets the new one take over the dead one's lock).
# A clean exit is an unlock, or a lock already running (qs -n).
shell=$(dirname "$(readlink -f "$0")")/..

for _ in 1 2 3 4 5; do
    qs -n -p "$shell/lock.qml" && exit 0
    # No session any more (a logout, the compositor gone): nothing to lock
    [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || exit 0
    sleep 1
done

notify-send -u critical -a Lock "Lock screen failed" "It crashed 5 times; see qs log -p $shell/lock.qml"
exit 1
