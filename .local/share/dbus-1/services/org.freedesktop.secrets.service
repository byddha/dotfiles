# KWallet (ksecretd) as the Secret Service outside Plasma. KWallet ships no activation file for
# org.freedesktop.secrets, so without this one D-Bus starts gnome-keyring and secrets split.
#
# The rest of the setup lives outside dotfiles; on a new machine:
#   1. pacman -S kwallet-pam kwalletmanager
#   2. /etc/pam.d/ly (owned by ly, edit by hand): drop the pam_gnome_keyring lines and end the
#      session line with: -session optional pam_kwallet5.so auto_start kwalletd=/usr/bin/ksecretd
#   3. kwalletmanager: new wallet named exactly "kdewallet", blowfish (not GPG), login password
#   4. ~/.config/kwalletrc: [org.freedesktop.secrets] apiEnabled=true
#   5. systemctl --user disable --now gnome-keyring-daemon.socket gnome-keyring-daemon.service
#   6. Copy the old gnome-keyring items over the Secret Service API (export while gnome-keyring
#      runs, import once ksecretd owns the name); binary values need application/octet-stream
# Also part of it: Secret=kwallet in xdg-desktop-portal/portals.conf (kwallet.portal is
# UseIn=kde) and pam_kwallet_init in the Hyprland autostart.
# KWalletManager does not list items stored through the Secret Service; use secret-tool.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/ksecretd
